      "50",
      "75",
      "100"
    ],
    "readingMultisets": 126
  },
  "search": {
    "casesChecked": 324,
    "status": "proved-by-algebra",
    "counterexample": null
  },
  "proof": {
    "method": "squared-error-factor-sign-v1",
    "identity": {
      "difference": "(a-t)^2-(b-t)^2",
      "product": "(a-b)(a+b-2t)",
      "expanded": {
        "a^2": 1,
        "b^2": -1,
        "a*t": -2,
        "b*t": 2
      }
    },
    "assumptions": [
      "a<=b",
      "t<=(a+b)/2"
    ],
    "factorSigns": [
      "nonpositive",
      "nonnegative"
    ],
    "result": "(a-t)^2<=(b-t)^2"
  },
