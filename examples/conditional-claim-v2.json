{
  "format": "inward-conditional-claim-v2",
  "claim": {
    "condition": "target-at-or-below-midpoint",
    "prediction": "lower-no-worse",
    "statement": "For any five real readings, if the target is at or below the estimates' midpoint, the lower estimate is no farther than the higher estimate."
  },
  "domain": {
    "readingValues": [
      "0",
      "25",
      "50",
      "75",
      "100"
    ],
    "targetValues": [
      "0",
